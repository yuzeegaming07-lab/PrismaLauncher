name: Build Prisma Launcher APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Ekstrak proyek
  run: |
    mkdir -p /tmp/prisma
    unzip -q PrismaLauncher-LAUNCH-READY.zip -d /tmp/prisma
    cp -R /tmp/prisma/PrismaLauncher/. .

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Build debug APK
        run: gradle assembleDebug

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: PrismaLauncher-APK
          path: app/build/outputs/apk/debug/app-debug.apk
